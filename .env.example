# Copy to .env and fill in as the modules require it. Never commit .env.

# 0x00+ — Ollama model tag (only set if you don't use qwen3:8b)
QWEN_MODEL=qwen3:8b

# 0x06 — Slack bot token (starts with xoxb-)
SLACK_BOT_TOKEN=
# A channel where your bot is invited, for manual testing
SLACK_TEST_CHANNEL=#bot-playground
